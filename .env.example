# Apple signing + notarization for local `make build` / `make build-mac`.
# Copy to `.env` (gitignored) and fill in:
#   cp .env.example .env
# Then:
#   make build-mac
# Or point at another file:
#   make build-mac ENV_FILE=.env.apple

# --- Code signing ---
# Prefer the identity already in your login keychain (after installing the .cer):
#   security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Optional CI-style path: base64 .p12 + password (Tauri imports into a temp keychain).
# Leave blank when the cert is already in Keychain Access → My Certificates.
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=

# --- Notarization (App Store Connect API key) ---
# Key ID column in App Store Connect → Users and Access → Integrations → Team Keys
APPLE_API_KEY=XXXXXXXXXX
# Issuer ID shown above the keys table
APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Path to the downloaded .p8 (download once from App Store Connect)
APPLE_API_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
